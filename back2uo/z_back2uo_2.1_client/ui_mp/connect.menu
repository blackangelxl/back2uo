#include "ui_mp/menudef.h"

/////////////
// Connect //
/////////////
{
	menuDef
	{
		name			"connect"
		rect			-128 0 896 480
		fullScreen		MENU_FALSE
		visible			MENU_FALSE
		backcolor		1 1 1 1
		style			WINDOW_STYLE_FILLED
		background		"$levelBriefing"
		focusColor		GLOBAL_FOCUSED_COLOR

		#include "ui_mp/bars_trans.menu"

		// Loading bar frame and bar, same rects as the stock CoD2 connect.menu.
		// Only shown once com_expectedhunkusage is known (from the second load of a map on,
		// the value is stored in hunkusage.dat).
		itemDef
		{
			name			"loadbar_background"
			decoration
			visible			1
			rect			317 421 262 16
			style			WINDOW_STYLE_SHADER
			background		"loadbar_background"
			dvartest		"com_expectedhunkusage"
			hidedvar		{ "0" }
		}

		itemDef
		{
			name			"loadbar"
			decoration
			visible			1
			rect			320 425 256 8
			style			WINDOW_STYLE_LOADBAR
			background		"white"
			forecolor		0.8 0 0 1
			dvartest		"com_expectedhunkusage"
			hidedvar		{ "0" }
		}

		// "Map Loading ..." text
		itemDef
		{
			name			"back2uo_loading"
			decoration
			visible			1
			rect			368 430 160 80
			style			WINDOW_STYLE_SHADER
			background		"gfx/custom/back2uo_loading.tga"
		}
	}
}
