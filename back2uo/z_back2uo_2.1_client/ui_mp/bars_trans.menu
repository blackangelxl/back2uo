		// Shared frame for the connect screen, whose menu rect is -128 0 896 480.
		// Same layout as bars_blank.menu, every x is shifted by +128 to make up for the menu offset.

		// Background image (metal bars top and bottom, transparent in between)
		itemDef
		{
			name			"background"
			decoration
			visible			1
			rect			128 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style			WINDOW_STYLE_SHADER
			background		"gfx/custom/back2uo_menubackground.tga"
		}

		// Lines (wider than the screen so they reach both edges at every aspect ratio)
		itemDef
		{
			name			"background_top_line"
			decoration
			visible			1
			rect			0 64 896 1 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style			WINDOW_STYLE_FILLED
			backcolor		.65 .65 .65 1
		}

		itemDef
		{
			name			"background_bottom_line"
			decoration
			visible			1
			rect			0 415 896 1 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style			WINDOW_STYLE_FILLED
			backcolor		.65 .65 .65 1
		}

