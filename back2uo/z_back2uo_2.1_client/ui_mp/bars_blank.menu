		// Shared frame for menus with rect 0 0 640 480 (see bars_trans.menu for the connect screen).
		// Background, lines and logo are placed relative to the menu's rect.

		// Background image (metal bars top and bottom, transparent in between)
		itemDef
		{
			name			"background"
			decoration
			visible			1
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style			WINDOW_STYLE_SHADER
			background		"gfx/custom/back2uo_menubackground.tga"
		}

		// Lines (wider than the screen so they reach both edges at every aspect ratio)
		itemDef
		{
			name			"background_top_line"
			decoration
			visible			1
			rect			-128 64 896 1 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style			WINDOW_STYLE_FILLED
			backcolor		.65 .65 .65 1
		}

		itemDef
		{
			name			"background_bottom_line"
			decoration
			visible			1
			rect			-128 415 896 1 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style			WINDOW_STYLE_FILLED
			backcolor		.65 .65 .65 1
		}

		// Back2Uo logo (hidden, menus show it with "show back2uo_logo" in onOpen)
		itemDef
		{
			name			"back2uo_logo"
			decoration
			visible			0
			rect			438 -12 205 103
			style			WINDOW_STYLE_SHADER
			background		"gfx/custom/back2uo_logo.tga"
		}
