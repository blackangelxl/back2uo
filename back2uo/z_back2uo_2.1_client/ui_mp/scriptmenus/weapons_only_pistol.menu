{
	menuDef
	{
		name			"weapons_only_pistol"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close weapons_only_pistol;
		}
		onOpen 
		{
			show luger_info;	
			show weapon_propertiestext;
			show back2uo_logo;
		}
		onClose
		{
		  hide luger_info;
      hide tt30_info;       
      hide webley_info;
			hide colt_info;				
		}

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}
				
    #include "ui_mp/bars_blank.menu"

		itemDef
		{
			type			ITEM_TYPE_TEXT
			visible			1
			origin			ORIGIN_TITLE
			forecolor		1 1 1 1
			text			"@MPUI_ONLY_PISTOL"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_HEADER_SIZE		
			decoration
		}

// MENU CHOICES
		
    execKey "1" { play "mouse_click"; scriptMenuResponse "colt_mp"; }
    execKey "2" { play "mouse_click"; scriptMenuResponse "luger_mp"; } 
    execKey "3" { play "mouse_click"; scriptMenuResponse "tt30_mp"; }
    execKey "4" { play "mouse_click"; scriptMenuResponse "webley_mp"; }

    ///-Colt-/// 
		itemDef 
		{
			name			"button_colt"
			visible			1
			rect			0 0 128 24
			origin			ORIGIN_CHOICE1
			forecolor		GLOBAL_UNFOCUSED_COLOR
			type			ITEM_TYPE_BUTTON
			text			"@MPUI_ONLY_PISTOL_COLT"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_TEXT_SIZE
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textaligny		20
			dvartest		"ui_allow_colt"
			showDvar		{ "1" }
			action
			{
				play "mouse_click";
				scriptMenuResponse "colt_mp";
			}
			onFocus
			{
			  hide luger_info;
        hide tt30_info;       
        hide webley_info;
				play "mouse_over";
				show colt_info;
				show weapon_propertiestext;
				show weapon_aktiv_info;
			}
		}
