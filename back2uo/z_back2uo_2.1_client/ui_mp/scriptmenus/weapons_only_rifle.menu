{
	menuDef
	{
		name			"weapons_only_rifle"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close weapons_only_rifle;
		}
		onOpen 
		{
			show g43_info;
			show weapon_propertiestext;
			show back2uo_logo;
		}
		onClose
		{
      hide kar98k_info;
      hide enfield_info;
      hide m1garand_info;
      hide m1carbine_info;
      hide nagant_info;
      hide svt40_info;				
		}

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}
				
    #include "ui_mp/bars_blank.menu"

		itemDef
		{
			type			ITEM_TYPE_TEXT
			visible			1
			origin			ORIGIN_TITLE
			forecolor		1 1 1 1
			text			"@MPUI_ONLY_RIFLE"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_HEADER_SIZE		
			decoration
		}

// MENU CHOICES
		
		execKey "1" { play "mouse_click"; scriptMenuResponse "g43_mp"; }
    execKey "2" { play "mouse_click"; scriptMenuResponse "kar98k_mp"; }
    execKey "3" { play "mouse_click"; scriptMenuResponse "enfield_mp"; }
    execKey "4" { play "mouse_click"; scriptMenuResponse "m1garand_mp" }
    execKey "5" { play "mouse_click"; scriptMenuResponse "m1carbine_mp" }
    execKey "6" { play "mouse_click"; scriptMenuResponse "mosin_nagant_mp"; }
    execKey "7" { play "mouse_click"; scriptMenuResponse "SVT40_mp"; }

    ///-G43-/// 
		itemDef 
		{
			name			"button_g43"
			visible			1
			rect			0 0 128 24
			origin			ORIGIN_CHOICE1
			forecolor		GLOBAL_UNFOCUSED_COLOR
			type			ITEM_TYPE_BUTTON
			text			"@MPUI_ONLY_RIFLE_G43"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_TEXT_SIZE
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textaligny		20
			dvartest		"ui_allow_g43"
			showDvar		{ "1" }
			action
			{
				play "mouse_click";
				scriptMenuResponse "g43_mp";
			}
			onFocus
			{
        hide kar98k_info;
        hide enfield_info;
        hide m1garand_info;
        hide m1carbine_info;
        hide nagant_info;
        hide svt40_info;
				play "mouse_over";
				show g43_info;
				show weapon_propertiestext;
				show weapon_aktiv_info;
			}
		}
