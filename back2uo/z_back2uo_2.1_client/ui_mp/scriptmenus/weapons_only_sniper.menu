{
	menuDef
	{
		name			"weapons_only_sniper"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close weapons_only_sniper;
		}
		onOpen 
		{
			show enfieldsniper_info;	
			show weapon_propertiestext;
			show back2uo_logo;
		}
		onClose
		{
			hide g43sniper_info;
      hide kar98ksniper_info;       
      hide nagantsniper_info;
      hide springfield_info;					
		}

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}
				
    #include "ui_mp/bars_blank.menu"

		itemDef
		{
			type			ITEM_TYPE_TEXT
			visible			1
			origin			ORIGIN_TITLE
			forecolor		1 1 1 1
			text			"@MPUI_ONLY_SNIPER"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_HEADER_SIZE		
			decoration
		}

// MENU CHOICES
		
    execKey "1" { play "mouse_click"; scriptMenuResponse "enfield_scope_mp"; }
    execKey "2" { play "mouse_click"; scriptMenuResponse "g43_sniper_mp"; } 
    execKey "3" { play "mouse_click"; scriptMenuResponse "kar98k_sniper_mp"; }
    execKey "4" { play "mouse_click"; scriptMenuResponse "mosin_nagant_sniper_mp"; }
    execKey "5" { play "mouse_click"; scriptMenuResponse "springfield_mp" }

    ///-Enfield Scope-/// 
		itemDef 
		{
			name			"button_enfieldscoped"
			visible			1
			rect			0 0 128 24
			origin			ORIGIN_CHOICE1
			forecolor		GLOBAL_UNFOCUSED_COLOR
			type			ITEM_TYPE_BUTTON
			text			"@MPUI_ONLY_SNIPER_SCOPED_LEEENFIELD"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_TEXT_SIZE
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textaligny		20
			dvartest		"ui_allow_enfieldsniper"
			showDvar		{ "1" }
			action
			{
				play "mouse_click";
				scriptMenuResponse "enfield_scope_mp";
			}
			onFocus
			{
			  hide g43sniper_info;
        hide kar98ksniper_info;       
        hide nagantsniper_info;
        hide springfield_info;
				hide weapon_deaktiv_info;
				play "mouse_over";
				show enfieldsniper_info;
				show weapon_propertiestext;
				show weapon_aktiv_info;
			}
		}
		itemDef 
		{
			name			"button_enfieldscoped"
			visible			1
			rect			0 0 128 24
			origin			ORIGIN_CHOICE1
			forecolor		GLOBAL_DISABLED_COLOR
