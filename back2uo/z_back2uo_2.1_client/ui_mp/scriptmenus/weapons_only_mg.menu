#include "ui_mp/menudef.h"

#define ORIGIN_TITLE		      48 64
#define ORIGIN_CHOICE1				80 84
#define ORIGIN_CHOICE2				80 108
#define ORIGIN_CHOICE3				80 132
#define ORIGIN_CHOICE4				80 156
#define ORIGIN_CHOICE5				80 180
#define ORIGIN_CHOICE6				80 204
#define ORIGIN_CHOICE7				80 228
#define ORIGIN_CHOICE8				80 252
#define ORIGIN_CHOICE9				80 276

#define ORIGIN_WEAPONIMAGE			    296 84
#define ORIGIN_WEAPONTEXT			      296 220
#define ORIGIN_WEAPONPROPERTIESTEXT	296 290
#define ORIGIN_WEAPONACCURACY		    395 277
#define ORIGIN_WEAPONDAMAGE			    395 301
#define ORIGIN_WEAPONMOBILITY		    395 325
#define ORIGIN_WEAPONSTATUS 		    395 349
#define ORIGIN_GRENADESLOT1			    296 144
#define ORIGIN_GRENADESLOT2			    312 144
#define ORIGIN_GRENADESLOT3			    328 144

{
	menuDef
	{
		name			"weapons_only_mg"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close weapons_only_mg;
		}
		onOpen 
		{
			show bar_info;
			show weapon_propertiestext;
			show back2uo_logo;
		}
		onClose
		{
      hide greasegun_info;
      hide mp40_info;
      hide mp44_info;
      hide ppsh_info;
      hide pps42_info;
      hide sten_info;
      hide thompson_info;				
		}

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}
				
    #include "ui_mp/bars_blank.menu"

		itemDef
		{
			type			ITEM_TYPE_TEXT
			visible			1
			origin			ORIGIN_TITLE
			forecolor		1 1 1 1
			text			"@MPUI_ONLY_MG"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_HEADER_SIZE		
			decoration
		}

// MENU CHOICES
	
		execKey "1" { play "mouse_click"; scriptMenuResponse "bar_mp" }
		execKey "2" { play "mouse_click"; scriptMenuResponse "bren_mp"; }
		execKey "3" { play "mouse_click"; scriptMenuResponse "greasegun_mp" }
		execKey "4" { play "mouse_click"; scriptMenuResponse "mp40_mp"; }
		execKey "5" { play "mouse_click"; scriptMenuResponse "mp44_mp"; }
		execKey "6" { play "mouse_click"; scriptMenuResponse "PPS42_mp"; }
		execKey "7" { play "mouse_click"; scriptMenuResponse "ppsh_mp"; }	
		execKey "8" { play "mouse_click"; scriptMenuResponse "sten_mp"; }
		execKey "9" { play "mouse_click"; scriptMenuResponse "thompson_mp" }

    ///-Bar-/// 
		itemDef 
		{
			name			"button_bar"
			visible			1
			rect			0 0 128 24
			origin			ORIGIN_CHOICE1
			forecolor		GLOBAL_UNFOCUSED_COLOR
			type			ITEM_TYPE_BUTTON
			text			"@MPUI_ONLY_MG_BAR"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_TEXT_SIZE
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textaligny		20
			dvartest		"ui_allow_bar"
			showDvar		{ "1" }
			action
			{
				play "mouse_click";
				scriptMenuResponse "bar_mp";
			}
			onFocus
			{
        hide bren_info;
        hide greasegun_info;
        hide mp40_info;
        hide mp44_info;
        hide ppsh_info;
        hide pps42_info;
        hide sten_info;
        hide thompson_info;
				hide weapon_deaktiv_info;
				play "mouse_over";
				show bar_info;
				show weapon_propertiestext;
				show weapon_aktiv_info;
			}
		}
