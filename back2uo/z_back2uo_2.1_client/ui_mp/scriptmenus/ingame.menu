#include "ui_mp/menudef.h"

#define ORIGIN_TITLE	48 64
// Back2Uo Server Information
#define ORIGIN_CHOICE1	80 84
#define ORIGIN_CHOICE2	80 108
#define ORIGIN_CHOICE3	80 132
#define ORIGIN_CHOICE4	80 156
#define ORIGIN_CHOICE5	80 180
#define ORIGIN_CHOICE6	80 204
#define ORIGIN_CHOICE7	80 228

{
	menuDef
	{
		name			"ingame"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close ingame;
		}
		onOpen 
		{
			show back2uo_logo;
		}		

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}

		#include "ui_mp/bars_blank.menu"

		itemDef
		{
			type			ITEM_TYPE_TEXT
			visible			1
			origin			ORIGIN_TITLE
			forecolor		1 1 1 1
			text			"@MENU_OPTIONS"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_HEADER_SIZE
			decoration
		}
		
// MENU CHOICES
    // Back2Uo Server Information
    execKey "1" { play "mouse_click"; scriptMenuResponse "serverinfos" }    
		execKey "2" { play "mouse_click"; scriptMenuResponse "changeweapon" }
		execKey "3" { play "mouse_click"; scriptMenuResponse "changeteam" }
		execKey "4" { play "mouse_click"; scriptMenuResponse "muteplayer" }
		execKey "5" { play "mouse_click"; scriptMenuResponse "callvote" }
		execKey "6" { play "mouse_click"; close ingame; open leavegame }
		execKey "7" { play "mouse_click"; open createfavorite_popmenu }
		
		// Back2Uo Server Information
		itemDef 
		{
			name			"button_serverinfos"
			visible			1
			rect			0 0 128 24
			origin			ORIGIN_CHOICE1
			forecolor		GLOBAL_UNFOCUSED_COLOR
			type			ITEM_TYPE_BUTTON
			text			"@MPUI_1_SERVER_INFOS"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_TEXT_SIZE
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textaligny		20
			action
			{
				play "mouse_click";
				scriptMenuResponse "serverinfos"
			}
			onFocus
			{
				play "mouse_over";
			}
		}
		
		itemDef
		{
			name			"button_changeweapon"
			visible			1
			rect			0 0 128 24
			origin			ORIGIN_CHOICE2
