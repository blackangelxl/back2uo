{
	menuDef
	{
		name			"weapons_german"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close weapons_german;
		}
		onOpen 
		{
			show mp40_info;
			show weapon_propertiestext;
			show back2uo_logo;		
		}
		onClose
		{
			hide kar98k_info;
			hide g43_info;
			hide mp40_info;
			hide mp44_info;
			hide kar98ksniper_info;
			hide shotgun_info;
			hide g43sniper_info;
			hide panzerschreck_info;
		}

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}

		#include "ui_mp/bars_blank.menu"

		itemDef
		{
			type			ITEM_TYPE_TEXT
			visible			1
			origin			ORIGIN_TITLE
			forecolor		1 1 1 1
			text			"@MPUI_GERMAN_WEAPONS"
			textfont		UI_FONT_NORMAL
			textscale		GLOBAL_HEADER_SIZE
			decoration
		}

// MENU CHOICES
		execKey "1" { play "mouse_click"; scriptMenuResponse "mp40_mp"; }
		execKey "2" { play "mouse_click"; scriptMenuResponse "kar98k_mp"; }
		execKey "3" { play "mouse_click"; scriptMenuResponse "g43_mp"; }
		execKey "4" { play "mouse_click"; scriptMenuResponse "kar98k_sniper_mp"; }
		execKey "5" { play "mouse_click"; scriptMenuResponse "shotgun_mp_axis"; }
		execKey "6" { play "mouse_click"; scriptMenuResponse "mp44_mp"; }
		execKey "7" { play "mouse_click"; scriptMenuResponse "g43_sniper_mp"; }
		execKey "8" { play "mouse_click"; scriptMenuResponse "panzerschreck_mp"; }

