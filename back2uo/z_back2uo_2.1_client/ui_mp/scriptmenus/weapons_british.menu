{
	menuDef
	{
		name			"weapons_british"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close weapons_british;
		}
		onOpen 
		{
			show sten_info;
			show weapon_propertiestext;
			show back2uo_logo;
		}
		onClose
		{
			hide sten_info;
			hide enfield_info;
			hide bren_info;
			hide enfieldsniper_info;
			hide thompson_info;
			hide shotgun_info;
			hide g43sniper_info;
			hide panzerschreck_info;
		}

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}
		
		#include "ui_mp/bars_blank.menu"

		itemDef
		{
			type			ITEM_TYPE_TEXT
			visible			1
