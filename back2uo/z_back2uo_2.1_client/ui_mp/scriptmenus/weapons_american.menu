				hide m1garand_info;
				hide bar_info;
				hide springfield_info;
				hide shotgun_info;
				hide g43sniper_info;
				hide panzerschreck_info;
				hide weapon_deaktiv_info;
				play "mouse_over";
				show greasegun_info;
				show weapon_propertiestext;
				show weapon_aktiv_info;
			}
		}
