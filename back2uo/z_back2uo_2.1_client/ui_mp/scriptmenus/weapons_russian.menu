{
	menuDef
	{
		name			"weapons_russian"
		rect			0 0 640 480
		focuscolor		GLOBAL_FOCUSED_COLOR
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc 
		{
			close weapons_russian;
		}
		onOpen 
		{
			show pps42_info;
			show weapon_propertiestext;
			show back2uo_logo;
		}
		onClose
		{
			hide nagant_info;
			hide svt40_info;
			hide pps42_info;
			hide ppsh_info;
			hide nagantsniper_info;
			hide shotgun_info;
			hide g43sniper_info;
			hide panzerschreck_info;
		}

		// Gradient
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			//rect			-107 0 554 480
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			background		"gradient"
			visible			1
			decoration
		}
				
