	// COMPASS
	menuDef
	{
		name			"Compass"
		fullScreen		MENU_FALSE
		visible			MENU_TRUE
		rect			-25 -143 COMPASS_SIZE COMPASS_SIZE HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_BOTTOM

		// Layers bottom to top: card (rotating), needle, head, glas, pointers; built by tools/compass2iwi.py
		itemDef
		{
			name			"compassface"	// card
			rect			0 0 COMPASS_SIZE COMPASS_SIZE
			forecolor		1.0 1.0 1.0 1.0
			background		"gfx/hud/hud@compassface.tga"
			ownerdraw		CG_PLAYER_COMPASS
			visible			MENU_TRUE
			decoration
		}

		// Needle and its head (off with back2uo_compassneedle 0)
		itemDef
		{
			name			"compassneedle"
			rect			0 0 COMPASS_SIZE COMPASS_SIZE
			forecolor		1.0 1.0 1.0 1.0
			background		"gfx/custom/back2uo_compass_needle.tga"
			ownerdraw		CG_PLAYER_COMPASS_BACK
			visible			MENU_TRUE
			decoration
			dvartest		"back2uo_ui_compassneedle"
			showDvar		{ "1" }
		}

		itemDef
		{
			name			"compasshead"
			rect			0 0 COMPASS_SIZE COMPASS_SIZE
			forecolor		1.0 1.0 1.0 1.0
			background		"gfx/custom/back2uo_compass_head.tga"
			ownerdraw		CG_PLAYER_COMPASS_BACK
			visible			MENU_TRUE
			decoration
			dvartest		"back2uo_ui_compassneedle"
			showDvar		{ "1" }
		}

		// Glass over card and needle
		itemDef
		{
			name			"compassglas"
			rect			0 0 COMPASS_SIZE COMPASS_SIZE
			forecolor		1.0 1.0 1.0 1.0
			background		"gfx/custom/back2uo_compass_glas.tga"
			ownerdraw		CG_PLAYER_COMPASS_BACK
			visible			MENU_TRUE
			decoration
		}

		// Objective pointers (top layer, above the glass)
		itemDef
		{
			name			"compasspointers"
			decoration
			visible			MENU_TRUE
			rect			0 0 COMPASS_SIZE COMPASS_SIZE
			forecolor		1.0 1.0 1.0 1.0
			ownerdraw		CG_PLAYER_COMPASS_POINTERS
		}

		// Friendlies pointers
		itemDef
		{
			name			"compassfriendlies"
			visible			MENU_TRUE
			rect			0 0 COMPASS_SIZE COMPASS_SIZE
			forecolor		1.0 1.0 1.0 1.0
			ownerdraw		CG_PLAYER_COMPASS_FRIENDS
			dvartest		"back2uo_ui_compassenemyfiring"
			showDvar		{ "1" }
		}
	}
