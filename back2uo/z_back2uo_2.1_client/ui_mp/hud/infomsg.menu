	// HUD OBJECTS (screen center)
	// Anchored to the horizontal screen center so the elements stay centered and keep
	// their aspect on 4:3 and widescreen (16:9 e.g. WQHD 2560x1440, 16:10) resolutions.
	// x is relative to the center (x = 0 equals x = 320 on the 640x480 virtual screen),
	// y is unchanged from the top. The matching script HUD texts
	// (_back2uo_binocular.gsc, _back2uo_weaponpickup.gsc) use horzAlign "center" too.
	menuDef
	{
		name			"infomsg"
		fullScreen		MENU_FALSE
		visible			MENU_TRUE
		rect			0 0 0 0 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_TOP

		// Binocular distance
		itemDef
		{
			name			"object_artillery_name"
			visible			1
			rect			0 392 0 0
			forecolor		1 1 1 0.8
			text			"@BACK2UOMOD_BINOCULAR_DISTANCE"
			textfont		UI_FONT_NORMAL
			textscale		.22
			textalign		ITEM_ALIGN_RIGHT
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			decoration
			dvartest		"back2uo_ui_artillery_name"
			showDvar		{ "1" }
		}

		itemDef
		{
			name			"object_artillery_meters"
			visible			1
			rect			23 392 0 0
			forecolor		1 1 1 0.8
			text			"@BACK2UOMOD_BINOCULAR_METERS"
			textfont		UI_FONT_NORMAL
			textscale		.22
			textalign		ITEM_ALIGN_LEFT
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			decoration
			dvartest		"back2uo_ui_artillery_meters"
			showDvar		{ "1" }
		}

		itemDef
		{
			name			"object_artillery_unknown"
			visible			1
			rect			15 392 0 0
			forecolor		1 1 1 0.8
			text			"@BACK2UOMOD_BINOCULAR_UNKNOWN"
			textfont		UI_FONT_NORMAL
			textscale		.22
			textalign		ITEM_ALIGN_LEFT
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			decoration
			dvartest		"back2uo_ui_artillery_unknown"
			showDvar		{ "1" }
		}

		// Artillery icon
		itemDef
		{
			name			"object_artillery_icon"
			style			WINDOW_STYLE_SHADER
			rect			95 282 40 40
			background		"artillery"
			forecolor		1 1 1 0.8
			visible			1
			decoration
			dvartest		"back2uo_ui_artillery_icon"
			showDvar		{ "1" }
		}

		#include "ui_mp/hud/weaponpickup.menu"
	}

	// HUD OBJECTS (bottom right, next to the health bar)
	// Anchored to the bottom right corner like the health bar (_back2uo_healthbar.gsc),
	// equals x = 535, y = 437 on the 640x480 virtual screen.
	menuDef
	{
		name			"infomsg_medic"
		fullScreen		MENU_FALSE
		visible			MENU_TRUE
		rect			0 0 0 0 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_BOTTOM

		// Medic icon
		itemDef
		{
			name			"objectpickup_medicicon"
			style			WINDOW_STYLE_SHADER
			rect			-105 -43 20 20
			background		"gfx/hud/hud@back2uo_medicicon.tga"
			forecolor		1 1 1 1
			visible			1
			decoration
			dvartest		"back2uo_ui_medicicon"
			showDvar		{ "1" }
		}
	}
