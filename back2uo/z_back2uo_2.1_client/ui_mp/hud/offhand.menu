	// OFFHAND WEAPONS
	menuDef
	{
		name			"offhandinfo"
		fullScreen		MENU_FALSE
		visible			MENU_TRUE
		rect			0 0 0 0 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_BOTTOM

		// offhand frag icon
		itemDef
		{
			name			"offhandfragicon"
			rect			-25 -95 20 20
			forecolor		1.0 1.0 1.0 1.0
			ownerdraw		CG_OFFHAND_WEAPON_ICON_FRAG
			visible			MENU_TRUE
			background		"gfx/icons/hud@russian_grenade.tga"	// default texture
			decoration
		}

		// offhand frag ammo
		itemDef
		{
			name			"offhandfragammo"
			rect			-38 -80 25 25
			textscale		.4
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textfont		UI_FONT_DEFAULT
			forecolor		1.0 1.0 1.0 1.0
			ownerdraw		CG_OFFHAND_WEAPON_AMMO_FRAG
			visible			MENU_TRUE
			decoration
		}

		// offhand smoke icon
		itemDef
		{
			name			"offhandsmokeicon"
			rect			-25 -70 20 20
			forecolor		1.0 1.0 1.0 1.0
			ownerdraw		CG_OFFHAND_WEAPON_ICON_SMOKE
			background		"hud_us_smokegrenade"	// default texture
			visible			MENU_TRUE
			decoration
		}

		// offhand smoke ammo
		itemDef
		{
			name			"offhandsmokeammo"
			rect			-38 -55 25 25
			textscale		.4
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textfont		UI_FONT_DEFAULT
			forecolor		1.0 1.0 1.0 1.0
			ownerdraw		CG_OFFHAND_WEAPON_AMMO_SMOKE
			visible			MENU_TRUE
			decoration
		}

		// Back2Uo binocular icon + count, one row above the frag icon (same step as frag -> smoke).
		// Client cvar back2uo_ui_binocular set by the server: "1" usable, "0" locked, "" hidden.
		// Icon: images/back2uo_hud_binocular.iwi (material gfx/custom/back2uo_hud_binocular.tga).
		itemDef
		{
			name			"back2uo_binocularicon"
			rect			-23 -120 20 20
			forecolor		1.0 1.0 1.0 1.0
			style			WINDOW_STYLE_SHADER
			background		"gfx/custom/back2uo_hud_binocular.tga"
			visible			MENU_TRUE
			decoration
			dvartest		"back2uo_ui_binocular"
			showDvar		{ "0" ; "1" }
		}

		// binocular count, same rect offset, font and scale as the grenade ammo
		// No text: the item shows the value of its dvar ("1" / "0").
		itemDef
		{
			name			"back2uo_binocularcount"
			type			ITEM_TYPE_TEXT
			rect			-39 -105 25 25
			textscale		.4
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textfont		UI_FONT_DEFAULT
			forecolor		1.0 1.0 1.0 1.0
			visible			MENU_TRUE
			decoration
			dvar			"back2uo_ui_binocular"
			dvartest		"back2uo_ui_binocular"
			showDvar		{ "0" ; "1" }
		}

