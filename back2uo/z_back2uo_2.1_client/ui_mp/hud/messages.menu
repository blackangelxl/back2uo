	// BACK2UO CREDITS
	menuDef
	{
		name			"back2uocredits"
		fullScreen		MENU_FALSE
		visible			MENU_TRUE
		rect			0 0 0 0 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_BOTTOM

		itemDef
		{
			name			"creditstext"
			type			ITEM_TYPE_TEXT
			visible			MENU_TRUE
			rect			10 -5 600 40	// 64x64
			textscale		.16
			textalign		ITEM_ALIGN_LEFT
			textfont		UI_FONT_NORMAL
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			forecolor		1 1 1 1
			text			"@BACK2UOMOD_MOD_CREDITS"
			dvartest		"back2uo_ui_modcredits"
			showDvar		{ "1" }
		}
	}

