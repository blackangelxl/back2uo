/*
	Back2Uo v2.1 - Bot waypoints: loads the waypoints of the current map and finds paths
	on them (A*).

	The waypoints are GSC scripts, back2uo\bots\waypoints\_wp_<mapname>.gsc, generated by
	tools/wp2gsc.py from MeatBot waypoints (layout described there). They ship inside the
	.iwd, so no file access is needed, and only stock script functions are used.
	The map's FX script (maps\mp\<mapname>_fx.gsc) sets level.back2uo_wp_mapscript to the
	load() of its waypoint script. That way only the current map's waypoints are compiled:
	all maps at once exceed the engine's script variable limit.

	Node and edge type bits:
		1	fall - drop down a ledge
		2	jump - jump to the next node
		4	mantle - climb over / onto the next node
		8	ladder - ladder between the two nodes
		16	grenade - grenade spot, level.back2uo_wp_angles[] = throw direction (nodes only)
		32	camp - camping spot, level.back2uo_wp_angles[] = look direction (nodes only)
	The generated edges are already directed: a fall edge has no way back up.

	Data after loading:
		level.back2uo_wp_count - number of nodes (ids 0 .. count - 1); 0 while loading or
			without waypoints
		level.back2uo_wp_origin[] - position per node id
		level.back2uo_wp_links[] - array of target node ids per node id (outgoing edges)
		level.back2uo_wp_linktype[] - per node id an array parallel to links[] holding the
			edge type bits; only set for nodes with a special edge, only non-zero entries set
		level.back2uo_wp_type[] - type bits per node id, only set for special nodes
		level.back2uo_wp_stance[] - "crouch" or "prone" per node id, only set when not standing
		level.back2uo_wp_angles[] - (pitch, yaw, 0) per node id, grenade and camp nodes only
*/

/*
=============
back2uo_waypoints_load

Loads the waypoints of the current map. The map script waits one frame per 250 nodes, so
large maps do not stall the server. level.back2uo_wp_count stays 0 until everything is
loaded. A new call stops a load that is still running.
Called on: level (threaded from back2uo_start_gametype)
=============
*/
back2uo_waypoints_load()
{
	level notify("back2uo_wp_load");
	level endon("back2uo_wp_load");

	level.back2uo_wp_count = 0;
	level.back2uo_wp_added = 0;
	level.back2uo_wp_origin = [];
	level.back2uo_wp_links = [];
	level.back2uo_wp_linktype = [];
	level.back2uo_wp_type = [];
	level.back2uo_wp_stance = [];
	level.back2uo_wp_angles = [];

	level.back2uo_wpbit = [];
	level.back2uo_wpbit["fall"] = 1;
	level.back2uo_wpbit["jump"] = 2;
	level.back2uo_wpbit["mantle"] = 4;
	level.back2uo_wpbit["ladder"] = 8;
	level.back2uo_wpbit["grenade"] = 16;
	level.back2uo_wpbit["camp"] = 32;

	// Set by the map's FX script; maps without waypoints do not set it
	if(!isdefined(level.back2uo_wp_mapscript))
	{
		back2uo\_back2uo_cvars::back2uo_logprint("Bot Waypoints", "no waypoints for " + getcvar("mapname"));
		return;
	}

	[[level.back2uo_wp_mapscript]]();

	level.back2uo_wp_count = level.back2uo_wp_added;

	back2uo\_back2uo_cvars::back2uo_logprint("Bot Waypoints", getcvar("mapname") + " " + level.back2uo_wp_count + " nodes");
}

/*
=============
back2uo_wp_addnode

Adds the next node and its outgoing edges; called by the generated map scripts. The node
id is the number of nodes added before it.
Params: x, y, z - position
		type - type bits
		stance - 0 stand, 1 crouch, 2 prone
		pitch, yaw - angles of grenade and camp spots, else 0
		e0 .. e19 - outgoing edges (target node id * 16 + edge type bits), unused ones undefined
=============
*/
back2uo_wp_addnode(x, y, z, type, stance, pitch, yaw, e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19)
{
	id = level.back2uo_wp_added;
	level.back2uo_wp_added++;

	level.back2uo_wp_origin[id] = (x, y, z);
	level.back2uo_wp_links[id] = [];

	if(type) level.back2uo_wp_type[id] = type;

	if(stance == 1) level.back2uo_wp_stance[id] = "crouch";
	else if(stance == 2) level.back2uo_wp_stance[id] = "prone";

	if(type & (level.back2uo_wpbit["grenade"] | level.back2uo_wpbit["camp"]))
		level.back2uo_wp_angles[id] = (pitch, yaw, 0);

	// The edges fill the parameters from e0 on, so the first undefined one ends the list
	if(!wp_addedge(id, e0)) return;
	if(!wp_addedge(id, e1)) return;
	if(!wp_addedge(id, e2)) return;
	if(!wp_addedge(id, e3)) return;
	if(!wp_addedge(id, e4)) return;
	if(!wp_addedge(id, e5)) return;
	if(!wp_addedge(id, e6)) return;
	if(!wp_addedge(id, e7)) return;
	if(!wp_addedge(id, e8)) return;
	if(!wp_addedge(id, e9)) return;
	if(!wp_addedge(id, e10)) return;
	if(!wp_addedge(id, e11)) return;
	if(!wp_addedge(id, e12)) return;
	if(!wp_addedge(id, e13)) return;
	if(!wp_addedge(id, e14)) return;
	if(!wp_addedge(id, e15)) return;
	if(!wp_addedge(id, e16)) return;
	if(!wp_addedge(id, e17)) return;
	if(!wp_addedge(id, e18)) return;
	wp_addedge(id, e19);
}

/*
=============
wp_addedge

Adds one outgoing edge to a node.
Params: id - node id
		edge - target node id * 16 + edge type bits, or undefined
Returns: false if edge is undefined (nothing added)
=============
*/
wp_addedge(id, edge)
{
	if(!isdefined(edge)) return false;

	index = level.back2uo_wp_links[id].size;

	level.back2uo_wp_links[id][index] = edge >> 4;

	if(edge & 15)
	{
		if(!isdefined(level.back2uo_wp_linktype[id])) level.back2uo_wp_linktype[id] = [];
		level.back2uo_wp_linktype[id][index] = edge & 15;
	}

	return true;
}

/*
=============
back2uo_wp_closest

Returns the id of the waypoint nearest to a position, or undefined without waypoints.
Checks every node; call it when a bot needs a new route, not every frame.
Params: origin - world position
=============
*/
back2uo_wp_closest(origin)
{
	best = undefined;
	bestdist = 0;

	for(i = 0; i < level.back2uo_wp_count; i++)
	{
		dist = distancesquared(origin, level.back2uo_wp_origin[i]);

		if(!isdefined(best) || dist < bestdist)
		{
			best = i;
			bestdist = dist;
		}
	}

	return best;
}

/*
=============
back2uo_wp_path

A* search. Returns the node ids from start to goal (both included), or undefined if the
goal cannot be reached. Waits one frame per 250 expanded nodes, so callers must allow waits.
Params: start - start node id
		goal - goal node id
=============
*/
back2uo_wp_path(start, goal)
{
	if(!level.back2uo_wp_count) return undefined;

	goalpos = level.back2uo_wp_origin[goal];

	cost = [];
	from = [];
	closed = [];

	open = spawnstruct();
	open.ids = [];
	open.f = [];
	open.n = 0;

	cost[start] = 0;
	heap_push(open, start, distance(level.back2uo_wp_origin[start], goalpos));
	steps = 0;

	while(open.n)
	{
		current = heap_pop(open);

		if(current == goal)
		{
			// Walk back along from[] and reverse
			back = [];
			for(id = goal; isdefined(id); id = from[id])
				back[back.size] = id;

			path = [];
			for(i = back.size - 1; i >= 0; i--)
				path[path.size] = back[i];

			return path;
		}

		// A node can sit in the heap more than once; only its first (cheapest) pop counts
		if(isdefined(closed[current])) continue;
		closed[current] = true;

		links = level.back2uo_wp_links[current];
		pos = level.back2uo_wp_origin[current];

		for(i = 0; i < links.size; i++)
		{
			next = links[i];

			if(isdefined(closed[next])) continue;

			newcost = cost[current] + distance(pos, level.back2uo_wp_origin[next]);

			if(!isdefined(cost[next]) || newcost < cost[next])
			{
				cost[next] = newcost;
				from[next] = current;
				heap_push(open, next, newcost + distance(level.back2uo_wp_origin[next], goalpos));
			}
		}

		steps++;
		if(steps % 250 == 0) wait .05;
	}

	return undefined;
}

/*
=============
back2uo_wp_edgetype

Returns the type bits of the edge from one node to the next (0 = walk), or undefined if
there is no such edge.
Params: from - node id
		to - node id
=============
*/
back2uo_wp_edgetype(from, to)
{
	links = level.back2uo_wp_links[from];

	for(i = 0; i < links.size; i++)
	{
		if(links[i] != to) continue;

		if(!isdefined(level.back2uo_wp_linktype[from]) || !isdefined(level.back2uo_wp_linktype[from][i])) return 0;

		return level.back2uo_wp_linktype[from][i];
	}

	return undefined;
}

/*
=============
back2uo_wp_istype

True if a waypoint has the given type, e.g. back2uo_wp_istype(id, "grenade").
Params: id - node id
		name - type name, see the bit table at the top of this file
=============
*/
back2uo_wp_istype(id, name)
{
	if(!isdefined(level.back2uo_wp_type[id])) return false;

	return (level.back2uo_wp_type[id] & level.back2uo_wpbit[name]) != 0;
}

/*
=============
heap_push

Adds a node to the binary min-heap of open nodes, sorted by f (cost so far + estimate).
Params: heap - struct with ids[], f[] and n
		id - node id
		f - sort value
=============
*/
heap_push(heap, id, f)
{
	i = heap.n;
	heap.n++;

	while(i > 0)
	{
		parent = int((i - 1) / 2);

		if(heap.f[parent] <= f) break;

		heap.ids[i] = heap.ids[parent];
		heap.f[i] = heap.f[parent];
		i = parent;
	}

	heap.ids[i] = id;
	heap.f[i] = f;
}

/*
=============
heap_pop

Removes and returns the node id with the lowest f from the heap. The heap must not be empty.
Params: heap - struct with ids[], f[] and n
=============
*/
heap_pop(heap)
{
	top = heap.ids[0];
	heap.n--;

	if(heap.n > 0)
	{
		// Sift the last entry down from the root
		lastid = heap.ids[heap.n];
		lastf = heap.f[heap.n];
		i = 0;

		for(;;)
		{
			child = i * 2 + 1;

			if(child >= heap.n) break;
			if(child + 1 < heap.n && heap.f[child + 1] < heap.f[child]) child++;
			if(heap.f[child] >= lastf) break;

			heap.ids[i] = heap.ids[child];
			heap.f[i] = heap.f[child];
			i = child;
		}

		heap.ids[i] = lastid;
		heap.f[i] = lastf;
	}

	heap.ids[heap.n] = undefined;
	heap.f[heap.n] = undefined;

	return top;
}
