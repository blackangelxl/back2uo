/*
	Back2Uo v2.1 - Trace cache: precomputed results of the static traces of a map.

	The cache is a GSC script per map, back2uo\tracecache\_tc_<mapname>.gsc, generated by
	tools/tcgen.py on the Docker test server (generator: tests/gsc/back2uo/test/_tcgen.gsc).
	It ships inside z_svr_back2uo_2.1.iwd, so the server needs no file access at run time.
	Like the bot waypoints it is referenced only from the map's FX script, so the engine
	compiles only the current map's cache:

		level.back2uo_tc_mapscript = back2uo\tracecache\_tc_<mapname>::load;

	The cache holds:
	- map bounds          back2uo_mapdimension (6 traces per entity, 9-25 seconds after
	                      every map and round start without the cache)
	- airplane edges      back2uo_airplane_vectorpos (start/end points of the fly-overs)

	All traces in it ignore entities (static map geometry only). Every lookup returns
	undefined when the cache does not know the answer; the caller then traces as before.
	Maps without a cache file work unchanged, their map bounds are cached in cvars
	(see tools\_back2uo_dimension.gsc).
*/

/*
=============
back2uo_tc_load

Loads the trace cache of the current map, if the map has one. Runs without waits, so the
cache is complete when it returns.
Called on: level (from _back2uo_player.gsc at gametype start, before back2uo_mapdimension)
=============
*/
back2uo_tc_load()
{
	level.back2uo_tc_ready = false;

	if(!isdefined(level.back2uo_tc_mapscript))
	{
		back2uo\_back2uo_cvars::back2uo_logprint("Trace Cache", "no cache for " + getcvar("mapname"));
		return;
	}

	[[level.back2uo_tc_mapscript]]();

	if(!isdefined(level.back2uo_tc_version) || level.back2uo_tc_version != back2uo_tc_version() || level.back2uo_tc_mapname != getcvar("mapname"))
	{
		back2uo\_back2uo_cvars::back2uo_logevent("tracecache", "skip", "map=" + getcvar("mapname") + " reason=version");
		return;
	}

	level.back2uo_tc_ready = true;

	back2uo\_back2uo_cvars::back2uo_logevent("tracecache", "load", "map=" + getcvar("mapname"));
}

/*
=============
back2uo_tc_version

Format version of the cache files; tools/tcgen.py writes the same number (TC_VERSION).
Returns: version number
=============
*/
back2uo_tc_version()
{
	return 2;
}

/*
=============
back2uo_tc_bounds

Map bounds from the cache file.
Returns: array [0] xMin, [1] xMax, [2] yMin, [3] yMax, [4] zMin, [5] zMax, or undefined
=============
*/
back2uo_tc_bounds()
{
	if(!isdefined(level.back2uo_tc_ready) || !level.back2uo_tc_ready) return undefined;

	return level.back2uo_tc_bounds;
}

/*
=============
back2uo_tc_airkey

Key of an airplane fly-over in the cache: heading and the x/y of the flight path center
(map center plus formation offset), in whole units.
Params: startpos - flight path center
		angle - flight yaw in degrees
Returns: key string
=============
*/
back2uo_tc_airkey(startpos, angle)
{
	return int(angle) + "_" + int(startpos[0]) + "_" + int(startpos[1]);
}

/*
=============
back2uo_tc_airplane

Cached start and end point of a fly-over (see back2uo_airplane_vectorpos). The cache
stores x/y only; the flight height is that of startpos (the traces are horizontal).
Params: startpos - flight path center (map center plus formation offset)
		angle - flight yaw in degrees
Returns: array [0] start point, [1] end point, or undefined if not cached
=============
*/
back2uo_tc_airplane(startpos, angle)
{
	if(!isdefined(level.back2uo_tc_ready) || !level.back2uo_tc_ready) return undefined;

	key = back2uo_tc_airkey(startpos, angle);
	if(!isdefined(level.back2uo_tc_air_start[key])) return undefined;

	s = level.back2uo_tc_air_start[key];
	e = level.back2uo_tc_air_end[key];

	stenpos = [];
	stenpos[0] = (s[0], s[1], startpos[2]);
	stenpos[1] = (e[0], e[1], startpos[2]);
	return stenpos;
}
